# Neon serverless Postgres connection string (pooled, HTTP driver).
# Create a free project at https://neon.tech and copy the connection string.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand--base64-32"

# Stripe TEST MODE keys (dashboard.stripe.com/test/apikeys) — never use live keys here.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary (optional) — enables "Upload image" for sellers. Without it,
# sellers can still paste any public https image URL.
# Free account: https://cloudinary.com → Dashboard → API keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
